# Grok (xAI) - get a key at console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4
# Later phases (FastAPI backend)
# DATABASE_URL=postgresql://...
# NEO4J_URI=

# Neon Postgres (Vercel Storage adds this). Leave empty locally for temporary in-memory storage.
DATABASE_URL=
# Any OpenAI-compatible provider works for AI explanations. Default is xAI.
GROK_BASE_URL=https://api.x.ai/v1

# Login. Leave SESSION_SECRET empty to run open (fine on your own computer). Set all three on Vercel.
SESSION_SECRET=
ADMIN_PASSWORD=
ANALYST_PASSWORD=

# Neo4j Aura Free. Use the connection URI and password from the Aura console.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
